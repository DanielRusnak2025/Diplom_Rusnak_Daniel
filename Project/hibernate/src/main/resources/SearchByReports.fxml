<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.Group?>

<AnchorPane
    style="-fx-background-color: #EDE0C1;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.controller.SearchByReportsController">

    <!-- Декор -->
    <Rectangle fill="#DCC999" opacity="0.43" height="1400.0" width="300.0" rotate="44.0"
               AnchorPane.leftAnchor="100.0" AnchorPane.topAnchor="-300.0"/>
    <Rectangle fill="#DCC999" opacity="0.43" height="1400.0" width="300.0" rotate="44.0"
               AnchorPane.rightAnchor="-100.0" AnchorPane.topAnchor="200.0"/>

    <VBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- ══ НАВИГАЦИЯ ══ -->
        <HBox spacing="10" style="-fx-padding: 12 14 12 14; -fx-alignment: center-left;">
            <Button fx:id="keywordSearchButton" mnemonicParsing="false"
                    onAction="#onKeywordSearch" prefHeight="37.0" prefWidth="200.0"
                    style="-fx-background-radius: 20; -fx-background-color: #294946;"
                    text="Search by keyword" textFill="#DCC999">
                <font><Font name="Arial Bold" size="15.0"/></font>
            </Button>
            <Button fx:id="usernameSearchButton" mnemonicParsing="false"
                    onAction="#onUsernameSearch" prefHeight="37.0" prefWidth="200.0"
                    style="-fx-background-radius: 20; -fx-background-color: #294946;"
                    text="Search by Username" textFill="#DCC999">
                <font><Font name="Arial Bold" size="15.0"/></font>
            </Button>
            <!-- Search by Reports — АКТИВНАЯ -->
            <Button fx:id="reportsSearchButton" mnemonicParsing="false"
                    onAction="#onReportsSearch" prefHeight="37.0" prefWidth="200.0"
                    style="-fx-background-radius: 20; -fx-background-color: rgba(41,73,70,0.5); -fx-border-color: #294946; -fx-border-radius: 20; -fx-border-width: 2;"
                    text="Search by Reports" textFill="#DCC999">
                <font><Font name="Arial Bold" size="15.0"/></font>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="settingsButton" mnemonicParsing="false"
                    onAction="#onSettings" prefHeight="37.0" prefWidth="37.0"
                    style="-fx-background-radius: 20; -fx-background-color: #294946; -fx-cursor: hand;">
                <graphic>
                    <SVGPath fillRule="EVEN_ODD"
                             content="M8.92497 0C7.82045 0 6.8145 0.595694 4.80272 1.78709L4.12229 2.19006C2.11047 3.38145 1.10457 3.97715 0.552289 4.95833C-1.77324e-07 5.93952 0 7.13092 0 9.51375V10.3196C0 12.7025 -1.77324e-07 13.8938 0.552289 14.875C1.10457 15.8562 2.11047 16.4518 4.12229 17.6432L4.80272 18.0463C6.8145 19.2376 7.82045 19.8333 8.92497 19.8333C10.0296 19.8333 11.0354 19.2376 13.0473 18.0463L13.7277 17.6432C15.7395 16.4518 16.7454 15.8562 17.2977 14.875C17.85 13.8938 17.85 12.7025 17.85 10.3196V9.51375C17.85 7.13092 17.85 5.93952 17.2977 4.95833C16.7454 3.97715 15.7395 3.38145 13.7277 2.19006L13.0473 1.78709C11.0354 0.595694 10.0296 0 8.92497 0ZM5.20625 9.91667C5.20625 7.86286 6.87123 6.19792 8.92497 6.19792C10.9788 6.19792 12.6437 7.86286 12.6437 9.91667C12.6437 11.9705 10.9788 13.6354 8.92497 13.6354C6.87123 13.6354 5.20625 11.9705 5.20625 9.91667Z"
                             fill="#D4C398"/>
                </graphic>
            </Button>
            <Button fx:id="logoutButton" mnemonicParsing="false"
                    onAction="#onLogout" prefHeight="37.0" prefWidth="37.0"
                    style="-fx-background-radius: 20; -fx-background-color: #294946; -fx-cursor: hand;">
                <graphic>
                    <Group>
                        <SVGPath content="M17.1465 14.1719C16.7593 14.5591 16.7593 15.1869 17.1465 15.5741C17.5337 15.9613 18.1616 15.9613 18.5487 15.5741L21.4371 12.6858C21.452 12.6709 21.4664 12.6556 21.4803 12.64C21.6849 12.4584 21.8138 12.1935 21.8138 11.8984C21.8138 11.6033 21.6849 11.3384 21.4803 11.1567C21.4664 11.1411 21.452 11.1259 21.4371 11.111L18.5487 8.22266C18.1616 7.83545 17.5337 7.83545 17.1465 8.22266C16.7593 8.60988 16.7593 9.23768 17.1465 9.62491L18.4285 10.9069H12.89C12.3423 10.9069 11.8984 11.3508 11.8984 11.8984C11.8984 12.446 12.3423 12.8899 12.89 12.8899H18.4285L17.1465 14.1719Z" fill="#D4C398"/>
                        <SVGPath content="M4.958 1.98303C3.31518 1.98303 1.9834 3.31481 1.9834 4.95763V18.8391C1.9834 20.482 3.31518 21.8137 4.958 21.8137H14.3776C15.7466 21.8137 16.8564 20.7039 16.8564 19.3349V16.5909C16.7095 16.506 16.5713 16.4008 16.4457 16.2752C15.7968 15.6263 15.6916 14.6398 16.13 13.8814H12.8903C11.795 13.8814 10.9072 12.9936 10.9072 11.8984C10.9072 10.8031 11.795 10.9069 12.8903 10.9069H16.13C15.6916 9.35342 15.7968 8.36695 16.4457 7.71883C16.5713 7.59327 16.7095 7.48820 16.8564 7.40317V4.46190C16.8564 3.09293 15.7466 1.98303 14.3776 1.98303H4.958Z" fill="#D4C398"/>
                    </Group>
                </graphic>
            </Button>
        </HBox>

        <!-- ══ ТЕЛО ══ -->
        <HBox VBox.vgrow="ALWAYS" spacing="0">

            <!-- ЛЕВАЯ КОЛОНКА: поиск + список жалоб -->
            <VBox spacing="8" style="-fx-padding: 0 10 10 14;"
                  prefWidth="300" minWidth="220">

                <!-- Поиск -->
                <HBox spacing="6" style="-fx-alignment: center-left;">
                    <TextField fx:id="keywordSearchField"
                               prefHeight="40.0" promptText="Enter here your keywords"
                               style="-fx-background-color: none; -fx-border-color: #294946; -fx-border-radius: 20; -fx-border-width: 2; -fx-background-radius: 20;"
                               HBox.hgrow="ALWAYS">
                        <font><Font name="Arial Bold" size="13.0"/></font>
                    </TextField>
                    <DatePicker fx:id="searchDatePicker"
                                prefHeight="40.0" prefWidth="46.0"
                                style="-fx-border-radius: 8; -fx-border-color: #294946; -fx-background-color: none; -fx-border-width: 2;"/>
                </HBox>

                <!-- Список жалоб — растёт -->
                <ListView fx:id="reportsListView" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: #D4C398; -fx-border-color: #294946; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10;"/>
            </VBox>

            <!-- ПРАВАЯ КОЛОНКА: детали жалобы -->
            <VBox spacing="10" style="-fx-padding: 0 14 14 0;"
                  HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

                <!-- Report Date + User Who Applied -->
                <GridPane hgap="14">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="35"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="65"/>
                    </columnConstraints>

                    <Label text="Report Date" textFill="#922B21"
                           GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <font><Font name="Arial Bold" size="15.0"/></font>
                    </Label>
                    <Label text="User Who Applied For Blocking" textFill="#922B21"
                           GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <font><Font name="Arial Bold" size="15.0"/></font>
                    </Label>

                    <HBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <TextField fx:id="reportDateField" prefHeight="40.0"
                                   editable="false"
                                   style="-fx-background-color: #D4C398; -fx-border-color: #294946; -fx-border-radius: 20; -fx-border-width: 2; -fx-background-radius: 20;"
                                   HBox.hgrow="ALWAYS">
                            <font><Font name="Arial Bold" size="14.0"/></font>
                        </TextField>
                        <Button mnemonicParsing="false" onAction="#copyReportDate"
                                style="-fx-background-color: none;" prefHeight="40.0" prefWidth="40.0">
                            <graphic>
                                <javafx.scene.shape.SVGPath
                                    content="M8.5 4.25H22.67C23.45 4.25 24.08 3.62 24.08 2.83C24.08 2.05 23.45 1.42 22.67 1.42H8.5C6.15 1.42 4.25 3.32 4.25 5.67V25.5C4.25 26.28 4.88 26.92 5.67 26.92C6.45 26.92 7.08 26.28 7.08 25.5V5.67C7.08 4.88 7.72 4.25 8.5 4.25ZM29.75 11.33C29.75 8.99 27.85 7.08 25.5 7.08H14.17C11.82 7.08 9.92 8.99 9.92 11.33V28.33C9.92 30.68 11.82 32.58 14.17 32.58H25.5C27.85 32.58 29.75 30.68 29.75 28.33V11.33ZM26.92 11.33C26.92 10.55 26.28 9.92 25.5 9.92H14.17C13.38 9.92 12.75 10.55 12.75 11.33V28.33C12.75 29.12 13.38 29.75 14.17 29.75H25.5C26.28 29.75 26.92 29.12 26.92 28.33V11.33Z"
                                    fill="#294946"/>
                            </graphic>
                        </Button>
                    </HBox>

                    <HBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <TextField fx:id="appliedUserField" prefHeight="40.0"
                                   editable="false"
                                   style="-fx-background-color: #D4C398; -fx-border-color: #294946; -fx-border-radius: 20; -fx-border-width: 2; -fx-background-radius: 20;"
                                   HBox.hgrow="ALWAYS">
                            <font><Font name="Arial Bold" size="14.0"/></font>
                        </TextField>
                        <Button mnemonicParsing="false" onAction="#copyAppliedUser"
                                style="-fx-background-color: none;" prefHeight="40.0" prefWidth="40.0">
                            <graphic>
                                <javafx.scene.shape.SVGPath
                                    content="M8.5 4.25H22.67C23.45 4.25 24.08 3.62 24.08 2.83C24.08 2.05 23.45 1.42 22.67 1.42H8.5C6.15 1.42 4.25 3.32 4.25 5.67V25.5C4.25 26.28 4.88 26.92 5.67 26.92C6.45 26.92 7.08 26.28 7.08 25.5V5.67C7.08 4.88 7.72 4.25 8.5 4.25ZM29.75 11.33C29.75 8.99 27.85 7.08 25.5 7.08H14.17C11.82 7.08 9.92 8.99 9.92 11.33V28.33C9.92 30.68 11.82 32.58 14.17 32.58H25.5C27.85 32.58 29.75 30.68 29.75 28.33V11.33ZM26.92 11.33C26.92 10.55 26.28 9.92 25.5 9.92H14.17C13.38 9.92 12.75 10.55 12.75 11.33V28.33C12.75 29.12 13.38 29.75 14.17 29.75H25.5C26.28 29.75 26.92 29.12 26.92 28.33V11.33Z"
                                    fill="#294946"/>
                            </graphic>
                        </Button>
                    </HBox>
                </GridPane>

                <!-- Blocked Article Title -->
                <Label text="Blocked Article Title" textFill="#922B21">
                    <font><Font name="Arial Bold" size="15.0"/></font>
                </Label>
                <HBox spacing="6">
                    <TextField fx:id="blockedArticleTitleField" prefHeight="40.0"
                               editable="false"
                               style="-fx-background-color: #D4C398; -fx-border-color: #294946; -fx-border-radius: 20; -fx-border-width: 2; -fx-background-radius: 20;"
                               HBox.hgrow="ALWAYS">
                        <font><Font name="Arial Bold" size="14.0"/></font>
                    </TextField>
                    <Button mnemonicParsing="false" onAction="#copyBlockedTitle"
                            style="-fx-background-color: none;" prefHeight="40.0" prefWidth="40.0">
                        <graphic>
                            <javafx.scene.shape.SVGPath
                                content="M8.5 4.25H22.67C23.45 4.25 24.08 3.62 24.08 2.83C24.08 2.05 23.45 1.42 22.67 1.42H8.5C6.15 1.42 4.25 3.32 4.25 5.67V25.5C4.25 26.28 4.88 26.92 5.67 26.92C6.45 26.92 7.08 26.28 7.08 25.5V5.67C7.08 4.88 7.72 4.25 8.5 4.25ZM29.75 11.33C29.75 8.99 27.85 7.08 25.5 7.08H14.17C11.82 7.08 9.92 8.99 9.92 11.33V28.33C9.92 30.68 11.82 32.58 14.17 32.58H25.5C27.85 32.58 29.75 30.68 29.75 28.33V11.33ZM26.92 11.33C26.92 10.55 26.28 9.92 25.5 9.92H14.17C13.38 9.92 12.75 10.55 12.75 11.33V28.33C12.75 29.12 13.38 29.75 14.17 29.75H25.5C26.28 29.75 26.92 29.12 26.92 28.33V11.33Z"
                                fill="#294946"/>
                        </graphic>
                    </Button>
                </HBox>

                <!-- Blocked Article Link -->
                <Label text="Blocked Article Link" textFill="#922B21">
                    <font><Font name="Arial Bold" size="15.0"/></font>
                </Label>
                <HBox spacing="6">
                    <TextField fx:id="blockedArticleLinkField" prefHeight="40.0"
                               editable="false"
                               style="-fx-background-color: #D4C398; -fx-border-color: #294946; -fx-border-radius: 20; -fx-border-width: 2; -fx-background-radius: 20;"
                               HBox.hgrow="ALWAYS">
                        <font><Font name="Arial Bold" size="14.0"/></font>
                    </TextField>
                    <Button mnemonicParsing="false" onAction="#copyBlockedLink"
                            style="-fx-background-color: none;" prefHeight="40.0" prefWidth="40.0">
                        <graphic>
                            <javafx.scene.shape.SVGPath
                                content="M8.5 4.25H22.67C23.45 4.25 24.08 3.62 24.08 2.83C24.08 2.05 23.45 1.42 22.67 1.42H8.5C6.15 1.42 4.25 3.32 4.25 5.67V25.5C4.25 26.28 4.88 26.92 5.67 26.92C6.45 26.92 7.08 26.28 7.08 25.5V5.67C7.08 4.88 7.72 4.25 8.5 4.25ZM29.75 11.33C29.75 8.99 27.85 7.08 25.5 7.08H14.17C11.82 7.08 9.92 8.99 9.92 11.33V28.33C9.92 30.68 11.82 32.58 14.17 32.58H25.5C27.85 32.58 29.75 30.68 29.75 28.33V11.33ZM26.92 11.33C26.92 10.55 26.28 9.92 25.5 9.92H14.17C13.38 9.92 12.75 10.55 12.75 11.33V28.33C12.75 29.12 13.38 29.75 14.17 29.75H25.5C26.28 29.75 26.92 29.12 26.92 28.33V11.33Z"
                                fill="#294946"/>
                        </graphic>
                    </Button>
                </HBox>

                <!-- Reason For Blocking — большое поле, растёт -->
                <Label text="Reason For Blocking" textFill="#922B21">
                    <font><Font name="Arial Bold" size="15.0"/></font>
                </Label>
                <HBox spacing="6" VBox.vgrow="ALWAYS">
                    <TextArea fx:id="reasonField"
                              editable="false" wrapText="true"
                              style="-fx-background-color: #D4C398; -fx-border-color: #294946; -fx-border-radius: 20; -fx-border-width: 2; -fx-background-radius: 20;"
                              HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                        <font><Font name="Arial Bold" size="14.0"/></font>
                    </TextArea>
                    <VBox alignment="BOTTOM_CENTER">
                        <Button mnemonicParsing="false" onAction="#copyReason"
                                style="-fx-background-color: none;" prefHeight="40.0" prefWidth="40.0">
                            <graphic>
                                <javafx.scene.shape.SVGPath
                                    content="M8.5 4.25H22.67C23.45 4.25 24.08 3.62 24.08 2.83C24.08 2.05 23.45 1.42 22.67 1.42H8.5C6.15 1.42 4.25 3.32 4.25 5.67V25.5C4.25 26.28 4.88 26.92 5.67 26.92C6.45 26.92 7.08 26.28 7.08 25.5V5.67C7.08 4.88 7.72 4.25 8.5 4.25ZM29.75 11.33C29.75 8.99 27.85 7.08 25.5 7.08H14.17C11.82 7.08 9.92 8.99 9.92 11.33V28.33C9.92 30.68 11.82 32.58 14.17 32.58H25.5C27.85 32.58 29.75 30.68 29.75 28.33V11.33ZM26.92 11.33C26.92 10.55 26.28 9.92 25.5 9.92H14.17C13.38 9.92 12.75 10.55 12.75 11.33V28.33C12.75 29.12 13.38 29.75 14.17 29.75H25.5C26.28 29.75 26.92 29.12 26.92 28.33V11.33Z"
                                    fill="#294946"/>
                            </graphic>
                        </Button>
                    </VBox>
                </HBox>

            </VBox>
        </HBox>
    </VBox>

    <!-- ══ ОВЕРЛЕЙ: НАСТРОЙКИ ══ -->
    <VBox fx:id="settingsOverlay" visible="false"
          AnchorPane.topAnchor="63" AnchorPane.rightAnchor="10"
          prefWidth="300" spacing="12"
          style="-fx-background-color: #EDE0C1; -fx-border-color: #294946; -fx-border-width: 2; -fx-border-radius: 16; -fx-background-radius: 16; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 12, 0, 0, 4);">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Notification frequency" style="-fx-font-family: 'Arial Bold'; -fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #294946;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="notifFreqButton" text="never ▶" onAction="#onNotifFreq"
                    style="-fx-background-color: #294946; -fx-text-fill: #D4C398; -fx-background-radius: 45; -fx-padding: 5 14 5 14; -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="11.0"/></font>
            </Button>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Add 2FA" style="-fx-font-family: 'Arial Bold'; -fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #294946;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="add" onAction="#onAdd2FA"
                    style="-fx-background-color: #294946; -fx-text-fill: #D4C398; -fx-background-radius: 45; -fx-padding: 5 14 5 14; -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="11.0"/></font>
            </Button>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Change password" style="-fx-font-family: 'Arial Bold'; -fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #294946;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="change" onAction="#onChangePassword"
                    style="-fx-background-color: #294946; -fx-text-fill: #D4C398; -fx-background-radius: 45; -fx-padding: 5 14 5 14; -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="11.0"/></font>
            </Button>
        </HBox>
    </VBox>

    <!-- ══ ОВЕРЛЕЙ: ПОДТВЕРЖДЕНИЕ ВЫХОДА ══ -->
    <VBox fx:id="logoutOverlay" visible="false"
          AnchorPane.topAnchor="63" AnchorPane.rightAnchor="10"
          prefWidth="300" spacing="16" alignment="CENTER"
          style="-fx-background-color: #EDE0C1; -fx-border-color: #294946; -fx-border-width: 2; -fx-border-radius: 16; -fx-background-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 12, 0, 0, 4);">
        <Label text="Are you sure you want to log out?" wrapText="true" maxWidth="Infinity"
               style="-fx-font-family: 'Arial Bold'; -fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #294946; -fx-text-alignment: center;"/>
        <HBox spacing="12" alignment="CENTER">
            <Button text="log out" onAction="#onConfirmLogout"
                    style="-fx-background-color: #294946; -fx-text-fill: #D4C398; -fx-background-radius: 45; -fx-padding: 8 22 8 22; -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="12.0"/></font>
            </Button>
            <Button text="cancel" onAction="#onCancelLogout"
                    style="-fx-background-color: #294946; -fx-text-fill: #D4C398; -fx-background-radius: 45; -fx-padding: 8 22 8 22; -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="12.0"/></font>
            </Button>
        </HBox>
    </VBox>

</AnchorPane>
