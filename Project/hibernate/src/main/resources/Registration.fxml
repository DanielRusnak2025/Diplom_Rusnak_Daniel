<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefWidth="430" prefHeight="932"
            minWidth="430" minHeight="932" maxWidth="430" maxHeight="932"
            style="-fx-background-color: #EDE0C1;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.RegistrationController">

    <!-- Декор -->
    <Rectangle fill="#DCC999" height="1093.0" width="407.0" rotate="44.0"
               AnchorPane.leftAnchor="412.0" AnchorPane.topAnchor="-234.0"/>

    <!-- Карточка регистрации -->
    <VBox spacing="16" alignment="CENTER"
          AnchorPane.topAnchor="130" AnchorPane.leftAnchor="28" AnchorPane.rightAnchor="28"
          style="-fx-background-color: #D4C398;
                 -fx-border-color: #294946;
                 -fx-border-width: 2.5;
                 -fx-border-radius: 24;
                 -fx-background-radius: 24;
                 -fx-padding: 32 28 32 28;">

        <Label text="Registration"
               style="-fx-font-size: 26; -fx-font-weight: 800; -fx-text-fill: #294946;"/>

        <TextField fx:id="loginField" promptText="Login" prefHeight="46.0"
                   maxWidth="Infinity"
                   style="-fx-background-color: #EDE0C1; -fx-border-color: #294946;
                          -fx-border-radius: 45; -fx-border-width: 2;
                          -fx-background-radius: 45; -fx-font-size: 16;
                          -fx-alignment: center; -fx-prompt-text-fill: rgba(41,73,70,0.6);">
            <font><Font name="Arial" size="16.0"/></font>
        </TextField>

        <PasswordField fx:id="passwordField" promptText="Password" prefHeight="46.0"
                       maxWidth="Infinity"
                       style="-fx-background-color: #EDE0C1; -fx-border-color: #294946;
                              -fx-border-radius: 45; -fx-border-width: 2;
                              -fx-background-radius: 45; -fx-font-size: 16;
                              -fx-alignment: center; -fx-prompt-text-fill: rgba(41,73,70,0.6);">
            <font><Font name="Arial" size="16.0"/></font>
        </PasswordField>

        <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" prefHeight="46.0"
                       maxWidth="Infinity"
                       style="-fx-background-color: #EDE0C1; -fx-border-color: #294946;
                              -fx-border-radius: 45; -fx-border-width: 2;
                              -fx-background-radius: 45; -fx-font-size: 16;
                              -fx-alignment: center; -fx-prompt-text-fill: rgba(41,73,70,0.6);">
            <font><Font name="Arial" size="16.0"/></font>
        </PasswordField>

        <!-- Ошибки -->
        <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="Infinity"
               style="-fx-text-fill: #C0392B; -fx-font-size: 13; -fx-font-weight: 800;"/>

        <!-- Кнопки -->
        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="backButton" text="Back to Login" onAction="#onBackToLogin"
                    prefHeight="42.0"
                    style="-fx-background-color: #294946; -fx-background-radius: 45;
                           -fx-text-fill: #D4C398; -fx-font-size: 14; -fx-font-weight: 800;
                           -fx-cursor: hand; -fx-padding: 8 20 8 20;">
                <font><Font name="Arial Bold" size="14.0"/></font>
            </Button>
            <Button fx:id="enterButton" text="Enter" onAction="#onEnter"
                    prefHeight="42.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    style="-fx-background-color: #294946; -fx-background-radius: 45;
                           -fx-text-fill: #D4C398; -fx-font-size: 14; -fx-font-weight: 800;
                           -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="14.0"/></font>
            </Button>
        </HBox>

    </VBox>

</AnchorPane>
