<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.Group?>

<AnchorPane
    prefWidth="520" prefHeight="932"
    minWidth="520" minHeight="932" maxWidth="520" maxHeight="932"
    style="-fx-background-color: #EDE0C1;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.controller.MainScreenController">

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  ОСНОВНОЙ КОНТЕНТ                                          -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          spacing="0">

        <!-- ══ ШАПКА: сайдбар + фильтры ══ -->
        <HBox spacing="8" style="-fx-padding: 10 10 0 10;" fillHeight="true">

            <!-- ЛЕВЫЙ ПИЛЛ-САЙДБАР (43px, pill) -->
            <VBox fx:id="sidebarPill" alignment="TOP_CENTER" spacing="10"
                  prefWidth="43" minWidth="43" maxWidth="43" prefHeight="122"
                  style="-fx-background-color: #294946; -fx-background-radius: 45; -fx-padding: 8 0 8 0;">

                <!-- Иконка пользователя (инициал проставляется из контроллера) -->
                <StackPane fx:id="userIconPane" prefWidth="27" prefHeight="27"
                           alignment="CENTER" style="-fx-cursor: hand;"/>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Кнопка истории (оценённые статьи) -->
                <Button fx:id="historyButton" text="≡" mnemonicParsing="false"
                        onAction="#onHistory" prefWidth="27" prefHeight="27"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #D4C398; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 0;"/>

                <!-- Кнопка выхода -->
                <Button fx:id="logoutSidebarButton" mnemonicParsing="false"
                        onAction="#onLogout" prefWidth="27" prefHeight="27"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 2;">
                    <graphic>
                        <Group>
                            <SVGPath content="M17.1465 14.1719C16.7593 14.5591 16.7593 15.1869 17.1465 15.5741C17.5337 15.9613 18.1616 15.9613 18.5487 15.5741L21.4371 12.6858C21.452 12.6709 21.4664 12.6556 21.4803 12.64C21.6849 12.4584 21.8138 12.1935 21.8138 11.8984C21.8138 11.6033 21.6849 11.3384 21.4803 11.1567C21.4664 11.1411 21.452 11.1259 21.4371 11.111L18.5487 8.22266C18.1616 7.83545 17.5337 7.83545 17.1465 8.22266C16.7593 8.60988 16.7593 9.23768 17.1465 9.62491L18.4285 10.9069H12.89C12.3423 10.9069 11.8984 11.3508 11.8984 11.8984C11.8984 12.446 12.3423 12.8899 12.89 12.8899H18.4285L17.1465 14.1719Z"
                                     fill="#D4C398" scaleX="0.85" scaleY="0.85"/>
                            <SVGPath content="M4.958 1.98303C3.31518 1.98303 1.9834 3.31481 1.9834 4.95763V18.8391C1.9834 20.482 3.31518 21.8137 4.958 21.8137H14.3776C15.7466 21.8137 16.8564 20.7039 16.8564 19.3349V16.5909C16.7095 16.506 16.5713 16.4008 16.4457 16.2752C15.7968 15.6263 15.6916 14.6398 16.13 13.8814H12.8903C11.795 13.8814 10.9072 12.9936 10.9072 11.8984C10.9072 10.8031 11.795 10.9069 12.8903 10.9069H16.13C15.6916 9.35342 15.7968 8.36695 16.4457 7.71883C16.5713 7.59327 16.7095 7.48820 16.8564 7.40317V4.46190C16.8564 3.09293 15.7466 1.98303 14.3776 1.98303H4.958Z"
                                     fill="#D4C398" scaleX="0.85" scaleY="0.85"/>
                        </Group>
                    </graphic>
                </Button>
            </VBox>

            <!-- ФИЛЬТРЫ — растягиваются на всю оставшуюся ширину -->
            <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">

                <!-- Ряд 1: ⚙ | Language ▶ | Newsroom ▶ -->
                <HBox spacing="6" fillHeight="true" maxWidth="Infinity">

                    <Button fx:id="settingsButton" mnemonicParsing="false"
                            onAction="#onSettings" prefHeight="32.0" prefWidth="40.0" minWidth="40.0"
                            style="-fx-background-radius: 45; -fx-background-color: #294946; -fx-cursor: hand;">
                        <graphic>
                            <SVGPath fillRule="EVEN_ODD"
                                     content="M8.92497 0C7.82045 0 6.8145 0.595694 4.80272 1.78709L4.12229 2.19006C2.11047 3.38145 1.10457 3.97715 0.552289 4.95833C-1.77324e-07 5.93952 0 7.13092 0 9.51375V10.3196C0 12.7025 -1.77324e-07 13.8938 0.552289 14.875C1.10457 15.8562 2.11047 16.4518 4.12229 17.6432L4.80272 18.0463C6.8145 19.2376 7.82045 19.8333 8.92497 19.8333C10.0296 19.8333 11.0354 19.2376 13.0473 18.0463L13.7277 17.6432C15.7395 16.4518 16.7454 15.8562 17.2977 14.875C17.85 13.8938 17.85 12.7025 17.85 10.3196V9.51375C17.85 7.13092 17.85 5.93952 17.2977 4.95833C16.7454 3.97715 15.7395 3.38145 13.7277 2.19006L13.0473 1.78709C11.0354 0.595694 10.0296 0 8.92497 0ZM5.20625 9.91667C5.20625 7.86286 6.87123 6.19792 8.92497 6.19792C10.9788 6.19792 12.6437 7.86286 12.6437 9.91667C12.6437 11.9705 10.9788 13.6354 8.92497 13.6354C6.87123 13.6354 5.20625 11.9705 5.20625 9.91667Z"
                                     fill="#D4C398"/>
                        </graphic>
                    </Button>

                    <Button fx:id="languageButton" mnemonicParsing="false"
                            onAction="#onLanguageFilter" text="Language ▶"
                            prefHeight="32.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #D4C398; -fx-border-color: #294946; -fx-border-radius: 45; -fx-background-radius: 45; -fx-border-width: 2; -fx-text-fill: #294946; -fx-cursor: hand;">
                        <font><Font name="Arial Bold" size="11.0"/></font>
                    </Button>
                    <Button fx:id="newsroomButton" mnemonicParsing="false"
                            onAction="#onNewsroomFilter" text="Newsroom ▶"
                            prefHeight="32.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #D4C398; -fx-border-color: #294946; -fx-border-radius: 45; -fx-background-radius: 45; -fx-border-width: 2; -fx-text-fill: #294946; -fx-cursor: hand;">
                        <font><Font name="Arial Bold" size="11.0"/></font>
                    </Button>
                </HBox>

                <!-- Ряд 2: 🔍 | Categories ▶ | Region ▶ | ✕ -->
                <HBox spacing="6" fillHeight="true" maxWidth="Infinity">

                    <Button fx:id="searchToggleButton" mnemonicParsing="false"
                            onAction="#onToggleSearch" prefHeight="32.0" prefWidth="40.0" minWidth="40.0"
                            style="-fx-background-radius: 45; -fx-background-color: #294946; -fx-cursor: hand;">
                        <graphic>
                            <Group>
                                <Circle centerX="9" centerY="9" radius="6.5"
                                        fill="transparent" stroke="#D4C398" strokeWidth="2.2"/>
                                <Line startX="13.6" startY="13.6" endX="18" endY="18"
                                      stroke="#D4C398" strokeWidth="2.2" strokeLineCap="ROUND"/>
                            </Group>
                        </graphic>
                    </Button>

                    <Button fx:id="categoriesButton" mnemonicParsing="false"
                            onAction="#onCategoriesFilter" text="Categories ▶"
                            prefHeight="32.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #D4C398; -fx-border-color: #294946; -fx-border-radius: 45; -fx-background-radius: 45; -fx-border-width: 2; -fx-text-fill: #294946; -fx-cursor: hand;">
                        <font><Font name="Arial Bold" size="11.0"/></font>
                    </Button>
                    <Button fx:id="regionButton" mnemonicParsing="false"
                            onAction="#onRegionFilter" text="Region ▶"
                            prefHeight="32.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #D4C398; -fx-border-color: #294946; -fx-border-radius: 45; -fx-background-radius: 45; -fx-border-width: 2; -fx-text-fill: #294946; -fx-cursor: hand;">
                        <font><Font name="Arial Bold" size="11.0"/></font>
                    </Button>
                    <Button fx:id="resetButton" mnemonicParsing="false"
                            onAction="#onResetFilters" text="✕"
                            prefHeight="32.0" prefWidth="32.0" minWidth="32.0"
                            style="-fx-background-radius: 45; -fx-background-color: #922B21; -fx-text-fill: #D4C398; -fx-cursor: hand;">
                        <font><Font name="Arial Bold" size="12.0"/></font>
                    </Button>
                </HBox>
            </VBox>
        </HBox>

        <!-- ══ БАННЕР: НОВЫЕ СТАТЬИ (скрыт до момента появления новых статей) ══ -->
        <HBox fx:id="newArticlesBanner" visible="false" managed="false"
              spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: #294946; -fx-background-radius: 10; -fx-padding: 9 14 9 16;">
            <VBox.margin><Insets top="6" right="10" left="10"/></VBox.margin>
            <Label fx:id="newArticlesBannerLabel" text="🔔 New articles available"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity"
                   style="-fx-text-fill: #D4C398; -fx-font-weight: bold; -fx-font-size: 13;">
                <font><Font name="Arial Bold" size="13.0"/></font>
            </Label>
            <Button text="↻ Load" onAction="#onRefreshNewArticles" mnemonicParsing="false"
                    style="-fx-background-color: #D4C398; -fx-text-fill: #294946;
                           -fx-background-radius: 45; -fx-padding: 5 14 5 14;
                           -fx-font-weight: bold; -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="11.0"/></font>
            </Button>
        </HBox>

        <!-- ══ ПОИСК (скрыт по умолчанию) ══ -->
        <HBox fx:id="searchRow" visible="false" managed="false"
              spacing="8" style="-fx-padding: 8 10 0 10;">
            <TextField fx:id="searchField"
                       promptText="Search articles..."
                       onAction="#onSearch"
                       HBox.hgrow="ALWAYS" maxWidth="Infinity"
                       style="-fx-background-color: #D4C398; -fx-border-color: #294946; -fx-border-radius: 45; -fx-background-radius: 45; -fx-border-width: 2; -fx-padding: 6 14 6 14;">
                <font><Font name="Arial" size="13.0"/></font>
            </TextField>
            <Button fx:id="enterButton" mnemonicParsing="false"
                    onAction="#onSearch" text="Enter" prefHeight="34.0" minWidth="60.0"
                    style="-fx-background-radius: 45; -fx-background-color: #294946; -fx-text-fill: #D4C398; -fx-cursor: hand; -fx-padding: 6 14 6 14;">
                <font><Font name="Arial Bold" size="11.0"/></font>
            </Button>
        </HBox>

        <!-- ══ СЧЁТЧИК ══ -->
        <Label fx:id="foundLabel" text="Loading..."
               style="-fx-padding: 6 10 2 10; -fx-text-fill: #294946; -fx-font-style: italic; -fx-font-size: 12;"/>

        <!-- ══ УВЕДОМЛЕНИЕ О ПОПУЛЯРНЫХ СТАТЬЯХ ══ -->
        <Label fx:id="popularNotifLabel" visible="false" managed="false"
               wrapText="true" maxWidth="Infinity"
               style="-fx-padding: 7 14 7 14;
                      -fx-background-color: #1B5E20;
                      -fx-text-fill: #EDE0C1;
                      -fx-font-size: 12;
                      -fx-font-weight: bold;
                      -fx-background-radius: 10;
                      -fx-margin: 0 10 4 10;">
            <VBox.margin><Insets top="2" right="10" bottom="4" left="10"/></VBox.margin>
        </Label>

        <!-- ══ СПИСОК СТАТЕЙ ══ -->
        <ListView fx:id="articlesList" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 5 5 5;"/>

    </VBox>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  ОВЕРЛЕЙ: НАСТРОЙКИ (поверх основного контента)            -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <VBox fx:id="settingsOverlay" visible="false"
          AnchorPane.topAnchor="115" AnchorPane.leftAnchor="63" AnchorPane.rightAnchor="10"
          spacing="12"
          style="-fx-background-color: #EDE0C1;
                 -fx-border-color: #294946;
                 -fx-border-width: 2;
                 -fx-border-radius: 16;
                 -fx-background-radius: 16;
                 -fx-padding: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 12, 0, 0, 4);">

        <!-- Notification frequency -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Notification frequency"
                   style="-fx-font-family: 'Arial Bold'; -fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #294946;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="notifFreqButton" text="never ▶" onAction="#onNotifFreq"
                    style="-fx-background-color: #294946; -fx-text-fill: #D4C398;
                           -fx-background-radius: 45; -fx-padding: 5 14 5 14; -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="11.0"/></font>
            </Button>
        </HBox>

        <!-- Add 2FA -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Add 2FA"
                   style="-fx-font-family: 'Arial Bold'; -fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #294946;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="add" onAction="#onAdd2FA"
                    style="-fx-background-color: #294946; -fx-text-fill: #D4C398;
                           -fx-background-radius: 45; -fx-padding: 5 14 5 14; -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="11.0"/></font>
            </Button>
        </HBox>

        <!-- Change password -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Change password"
                   style="-fx-font-family: 'Arial Bold'; -fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #294946;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="change" onAction="#onChangePassword"
                    style="-fx-background-color: #294946; -fx-text-fill: #D4C398;
                           -fx-background-radius: 45; -fx-padding: 5 14 5 14; -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="11.0"/></font>
            </Button>
        </HBox>

    </VBox>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  ОВЕРЛЕЙ: ПОДТВЕРЖДЕНИЕ ВЫХОДА                             -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <VBox fx:id="logoutOverlay" visible="false"
          AnchorPane.topAnchor="115" AnchorPane.leftAnchor="63" AnchorPane.rightAnchor="10"
          spacing="16" alignment="CENTER"
          style="-fx-background-color: #EDE0C1;
                 -fx-border-color: #294946;
                 -fx-border-width: 2;
                 -fx-border-radius: 16;
                 -fx-background-radius: 16;
                 -fx-padding: 24;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 12, 0, 0, 4);">

        <Label text="Are you sure you want to log out?" wrapText="true"
               maxWidth="Infinity"
               style="-fx-font-family: 'Arial Bold'; -fx-font-size: 14; -fx-font-weight: bold;
                      -fx-text-fill: #294946; -fx-text-alignment: center;"/>

        <HBox spacing="12" alignment="CENTER">
            <Button text="log out" onAction="#onConfirmLogout"
                    style="-fx-background-color: #294946; -fx-text-fill: #D4C398;
                           -fx-background-radius: 45; -fx-padding: 8 22 8 22; -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="12.0"/></font>
            </Button>
            <Button text="cancel" onAction="#onCancelLogout"
                    style="-fx-background-color: #294946; -fx-text-fill: #D4C398;
                           -fx-background-radius: 45; -fx-padding: 8 22 8 22; -fx-cursor: hand;">
                <font><Font name="Arial Bold" size="12.0"/></font>
            </Button>
        </HBox>

    </VBox>

</AnchorPane>
