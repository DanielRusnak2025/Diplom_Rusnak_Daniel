# Compiled output
target/
*.class
*.jar
*.war
*.ear
*.nar

# Gradle build outputs and caches
.gradle/
build/

# Gradle wrapper jar must be committed — override the *.jar rule above
!gradle/wrapper/gradle-wrapper.jar

# Maven
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Eclipse
.classpath
.project
.settings/
bin/

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
**/logs/

# Environment / secrets
*.env
.env
email.properties
hibernate.cfg.xml
ai.properties

# JavaFX / runtime
*.dylib
*.so
*.dll

# Claude Code tooling
.claude/

# SQL dumps / backups (outside migrations folder)
/backups/
*.dump

# MySQL credentials file
.mylogin.cnf

# Certificates and keystores
*.pem
*.key
*.p12
*.jks

# Local run scripts (machine-specific paths)
run.bat

# Temporary files
*.tmp
*.swp
*~
